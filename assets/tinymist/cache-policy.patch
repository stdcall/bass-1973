+/// Return a complete trace only when its exact main-evaluation prefix has
+/// already reached the upstream sink limit. Otherwise retain full compilation.
+fn saturated_main_eval_trace(
+    world: &dyn World,
+    span: Span,
+) -> Option<EcoVec<(Value, Option<Styles>)>> {
+    let main = world.source(world.main()).ok()?;
+    let traced = Traced::new(span);
+    let mut sink = Sink::new();
+    typst_shim::eval::eval(
+        world.track(),
+        world.library(),
+        traced.track(),
+        sink.track_mut(),
+        Route::default().track(),
+        &main,
+    )
+    .ok();
+    let values = sink.values();
+    (values.len() == Sink::MAX_VALUES).then_some(values)
+}
